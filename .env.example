# .env.example
# Copy to .env.development / .env.staging / .env.production and fill in
# real values. Never commit the filled-in versions — confirm _gitignore
# excludes .env* (not just .env itself).

# Required. One of: development, staging, production.
# security.py raises at import time if this is missing or unrecognized.
WATTWISE_ENV=development

# Database. Leave blank to use a local SQLite file (fine for running on your own
# machine). For a public deployment, paste your Supabase *Session pooler* string
# here (see DEPLOYMENT.md). Never commit a filled-in copy of this file.
DATABASE_URL=

# Redis connection string, used by the rate limiter once it's moved off
# in-process memory (see security.py's InMemoryRateLimiter docstring).
REDIS_URL=redis://localhost:6379/0

# Tariff defaults — override per-DISCOM once real rates are known.
# These are NOT secret, safe to leave at defaults for a demo.
WATTWISE_PEAK_START=18
WATTWISE_PEAK_END=22
WATTWISE_SHOULDER_START=10
WATTWISE_SHOULDER_END=13
WATTWISE_PEAK_RATE=12.0
WATTWISE_SHOULDER_RATE=7.0
WATTWISE_OFF_PEAK_RATE=4.0

# Model hyperparameters — safe at defaults, override for experimentation.
WATTWISE_RF_TREES=80
WATTWISE_RF_MAX_DEPTH=12
WATTWISE_MIN_TRAIN_ROWS=200
WATTWISE_ANOMALY_Z_FORECAST=2.0
WATTWISE_ANOMALY_Z_HISTORICAL=2.5

WATTWISE_LOG_LEVEL=INFO

# Optional — only needed once you wire up src/external_apis.py's stub
# functions to a real weather/solar or DISCOM/meter API. Leave blank
# until you have one; the stubs raise NotImplementedError until then.
WATTWISE_WEATHER_API_KEY=
WATTWISE_METER_API_KEY=

# Optional — points a specific real dataset filename in data/ instead of
# the default household_power_consumption.txt
WATTWISE_DATA_FILE=household_power_consumption.txt

# Optional WhattsOn Gemini enhancement. Leave false/blank to use the built-in deterministic assistant.
# Google AI Studio creates API keys; never commit the real key.
GEMINI_API_KEY=
WATTWISE_USE_GEMINI=false
# Keep this configurable because Gemini model availability changes over time.
GEMINI_MODEL=gemini-3.8-flash
